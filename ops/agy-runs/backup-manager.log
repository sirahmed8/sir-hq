/**
 * When the mobile keyboard opens while a text field is focused, scroll that field to the middle of its nearest
 * scroll ancestor so the person always sees what they type. This covers every text input on every screen, not
 * just the chat shell, because the owner asked that any type box rises above the keyboard.
 *
 * Does not write any CSS custom properties; that is useKeyboardViewport's job. This hook only moves the scroll.
 */
export function useKeyboardFocusReveal(): void {
  useEffect(() => {

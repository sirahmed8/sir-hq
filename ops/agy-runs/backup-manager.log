"use client";

import React, { useEffect, useMemo, useRef, useState } from "react";
import { RotateCcw, RotateCw, ZoomIn, ZoomOut } from "lucide-react";
import {
  DEFAULT_EDITOR_STATE, EDITOR_LIMITS, clampState, coverScale, rotateState, type EditorState,
} from "@/lib/profile/avatarEditor";
import { renderEditedAvatar } from "@/lib/profile/avatarRender";

const FRAME_PX = 240;

interface AvatarEditorProps {
  source: ImageBitmap;
  isRtl: boolean;
  onCancel: () => void;
  onSave: (dataUrl: string) => void;
}

/**
 * Crop sheet for a profile photo: drag to move, slider or buttons to zoom, quarter turns to
 * rotate, reset to the start, then save. The circle shows how the avatar will look.
 */
export const AvatarEditor: React.FC<AvatarEditorProps> = ({ source, isRtl, onCancel, onSave }) => {
  const [state, setState] = useState<EditorState>(DEFAULT_EDITOR_STATE);
  const [error, setError] = useState<string | null>(null);
  const drag = useRef<{ x: number; y: number; ox: number; oy: number } | null>(null);
  const previewSrc = useMemo(() => toPreviewSrc(source), [source]);

  const cover = coverScale(source.width, source.height, FRAME_PX, state.rotation);
  const drawW = source.width * cover * state.zoom;
  const drawH = source.height * cover * state.zoom;
  const apply = (next: EditorState) => setState(clampState(source.width, source.height, FRAME_PX, next));

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") onCancel();
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [onCancel]);

  const save = () => {
    try {
      onSave(renderEditedAvatar(source, FRAME_PX, state));
    } catch {
      setError(isRtl ? "مقدرناش نحفظ الصورة دي. جرّب تانية." : "This photo could not be saved. Try again.");
    }
  };

  const btn = "grid min-h-[44px] min-w-[44px] place-items-center rounded-xl border border-white/15 bg-white/5 text-white/85 transition active:scale-[0.96] hover:bg-white/10";

  return (
    <div role="dialog" aria-modal="true" aria-label={isRtl ? "اقتصاص الصورة" : "Crop photo"} className="flex flex-col items-center gap-4">
      <div
        className="relative touch-none select-none overflow-hidden rounded-full bg-zinc-900 ring-1 ring-white/15 cursor-grab active:cursor-grabbing"
        style={{ width: FRAME_PX, height: FRAME_PX }}
        onPointerDown={(e) => {
          drag.current = { x: e.clientX, y: e.clientY, ox: state.offsetX, oy: state.offsetY };
          e.currentTarget.setPointerCapture(e.pointerId);
        }}
        onPointerMove={(e) => {
          const d = drag.current;
          if (!d) return;
          apply({ ...state, offsetX: d.ox + (e.clientX - d.x), offsetY: d.oy + (e.clientY - d.y) });
        }}
        onPointerUp={() => {
          drag.current = null;
        }}
        onPointerCancel={() => {
          drag.current = null;
        }}
      >
        <img
          alt=""
          draggable={false}
          src={previewSrc}
          className="pointer-events-none absolute left-1/2 top-1/2 max-w-none"
          style={{
            width: drawW,
            height: drawH,
            transform: `translate(calc(-50% + ${state.offsetX}px), calc(-50% + ${state.offsetY}px)) rotate(${state.rotation}deg)`,
          }}
        />
      </div>

      <div className="flex w-full max-w-[280px] items-center gap-2">
        <button type="button" className={btn} aria-label={isRtl ? "تصغير" : "Zoom out"} onClick={() => apply({ ...state, zoom: state.zoom - 0.1 })}>
          <ZoomOut className="h-4 w-4" aria-hidden="true" />
        </button>
        <input
          type="range"
          min={EDITOR_LIMITS.zoomMin}
          max={EDITOR_LIMITS.zoomMax}
          step={0.01}
          value={state.zoom}
          aria-label={isRtl ? "التكبير" : "Zoom"}
          onChange={(e) => apply({ ...state, zoom: Number(e.target.value) })}
          className="flex-1 min-h-[44px] avatar-zoom-track"
        />
        <button type="button" className={btn} aria-label={isRtl ? "تكبير" : "Zoom in"} onClick={() => apply({ ...state, zoom: state.zoom + 0.1 })}>
          <ZoomIn className="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <div className="flex w-full max-w-[280px] items-center justify-between gap-2">
        <button type="button" className={`${btn} !flex items-center gap-1.5 px-3 text-xs font-bold whitespace-nowrap`} onClick={() => setState((s) => rotateState(source.width, source.height, FRAME_PX, s))}>
          <RotateCw className="h-4 w-4" aria-hidden="true" />
          {isRtl ? "لف" : "Rotate"}
        </button>
        <button type="button" className={`${btn} !flex items-center gap-1.5 px-3 text-xs font-bold whitespace-nowrap`} onClick={() => setState(DEFAULT_EDITOR_STATE)}>
          <RotateCcw className="h-4 w-4" aria-hidden="true" />
          {isRtl ? "استرجاع" : "Reset"}
        </button>
      </div>

      {error && <p role="alert" className="text-xs font-semibold text-rose-300">{error}</p>}

      <div className="flex w-full max-w-[280px] gap-2">
        <button type="button" onClick={onCancel} className="min-h-[44px] flex-1 rounded-xl border border-white/15 px-3 text-sm font-bold text-white/80 active:scale-[0.98]">
          {isRtl ? "إلغاء" : "Cancel"}
        </button>
        <button type="button" onClick={save} className="min-h-[44px] flex-1 rounded-xl bg-rose-500 px-3 text-sm font-bold text-white active:scale-[0.98] hover:bg-rose-400">
          {isRtl ? "حفظ الصورة" : "Save photo"}
        </button>
      </div>
    </div>
  );
};

/** A preview URL for the picked photo. The bitmap is drawn to a canvas, so the page only shows the pixels it already has. */
function toPreviewSrc(source: ImageBitmap): string {
  const canvas = document.createElement("canvas");
  canvas.width = source.width;
  canvas.height = source.height;
  canvas.getContext("2d")?.drawImage(source, 0, 0);
  return canvas.toDataURL("image/png");
}

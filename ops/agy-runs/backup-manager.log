 /**
+ * Advances the rotation by one quarter turn and remaps the pan so the same photo content stays under the
+ * cursor. Rotating the photo 90 degrees clockwise moves its old right edge to the bottom, so the offset
+ * vector turns the other way: (ox, oy) -> (-oy, ox). The clamp afterwards re-bounds the pan for the new
+ * rotated photo size, so no empty frame edge can appear mid-rotation.
+ */
+export function rotateState(width: number, height: number, frame: number, state: EditorState): EditorState {
+  const rotation = nextRotation(state.rotation);
+  return clampState(width, height, frame, {
+    zoom: state.zoom,
+    rotation,
+    offsetX: -state.offsetY,
+    offsetY: state.offsetX,
+  });
+}
+

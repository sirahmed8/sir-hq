const pairs = [
  ["before-tokens-390-light-en", true],
  ["after-tokens-390-light-en", false],
  ["after-tokens-390-light-ar", false],
  ["after-tokens-320-light-en", false],
];

const browser = await chromium.launch({ headless: true, args: ["--mute-audio"] });
try {
  for (const [name, before] of pairs) {
    const locale = name.includes("-ar") ? "ar-EG" : "en-US";
    const width = name.includes("320") ? 320 : 390;
    const ctx = await browser.newContext({ viewport: { width, height: 844 }, colorScheme: "light", locale, isMobile: true, hasTouch: true });
    await ctx.addInitScript(({ l, t }) => {
      try {
        localStorage.setItem("sanctuary_lang_v2", l);
        localStorage.setItem("sanctuary_theme_preset", t);
        globalThis.speechSynthesis.speak = () => {};
      } catch {}
    }, { l: locale, t: "light" });
    const page = await ctx.newPage();
    await page.goto("http://127.0.0.1:3001/", { waitUntil: "domcontentloaded", timeout: 30000 });
    await page.waitForTimeout(1200);
    if (before) {
      await page.addStyleTag({ content: `[data-theme="light"] [data-page="dark"]{--text-muted:#525866 !important;--text:#0f172a !important}` });
      await page.waitForTimeout(300);
    }
    mkdirSync(join(out, name), { recursive: true });
    await page.screenshot({ path: join(out, name, `home-${width}-light-${locale}.png`) });
    console.log(name, "ok");
    await ctx.close();
  }
} finally {
  await browser.close();

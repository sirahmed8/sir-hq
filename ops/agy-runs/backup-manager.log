"use client";

import React, { useState } from "react";
import { ChatTab } from "@/components/tabs/ChatTab";
import { VoiceAIStudioTab } from "@/components/tabs/VoiceAIStudioTab";
import { BottomNavBar } from "@/components/BottomNavBar";
import type { ChatMessage } from "@/types";

const NOW = Date.now();

export default function DevChatKeyboardPage() {
  const [tab, setTab] = useState<"chat" | "ai_studio">("chat");
  const [rtl, setRtl] = useState(true);
  const [theme, setTheme] = useState<"dark" | "light">("dark");
  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      id: "msg_1",
      sender: "ahmed",
      text: "صباح الورد يا حبيبتي",
      timestamp: NOW - 3600000,
      status: "read",
      reactions: {},
    },
    {
      id: "msg_2",
      sender: "habiba",
      text: "صباح النور يا قلبي، يومك جميل يارب",
      timestamp: NOW - 1800000,
      status: "read",
      reactions: {},
    },
    {
      id: "msg_3",
      sender: "ahmed",
      text: "جهزتلك كل حاجة، طمنيني عليكي أول ما توصلي المحاضرة",
      timestamp: NOW - 60000,
      status: "read",
      reactions: {},
    },
  ]);

  const toggleRtl = () => {
    const next = !rtl;
    document.documentElement.dir = next ? "rtl" : "ltr";
    document.documentElement.lang = next ? "ar" : "en";
    setRtl(next);
  };

  const toggleTheme = () => {
    const next = theme === "dark" ? "light" : "dark";
    document.documentElement.classList.toggle("dark", next === "dark");
    setTheme(next);
  };

  return (
    <div className="min-h-screen bg-zinc-950 text-white flex flex-col justify-between">
      {/* Test Controls */}
      <div className="fixed top-1 inset-x-0 z-50 flex justify-center gap-2 p-1 bg-black/80 backdrop-blur-md pointer-events-auto">
        <button
          type="button"
          id="btn-switch-tab"
          onClick={() => setTab(tab === "chat" ? "ai_studio" : "chat")}
          className="px-2 py-1 bg-white/10 rounded text-xs"
        >
          Tab: {tab}
        </button>
        <button
          type="button"
          id="btn-rtl"
          onClick={toggleRtl}
          className="px-2 py-1 bg-white/10 rounded text-xs"
        >
          RTL: {rtl ? "ar" : "en"}
        </button>
        <button
          type="button"
          id="btn-theme"
          onClick={toggleTheme}
          className="px-2 py-1 bg-white/10 rounded text-xs"
        >
          Theme: {theme}
        </button>
      </div>

      <main className="chat-shell min-h-screen flex flex-col justify-between relative pt-12 overflow-hidden w-full max-w-md mx-auto">
        <div
          data-chat-container="true"
          className="flex-1 px-3 sm:px-4 mt-2 min-h-0 overflow-hidden flex flex-col pb-[var(--dock-clearance)]"
        >
          {tab === "chat" ? (
            <div className="w-full flex min-h-0 flex-1 flex-col overflow-x-hidden">
              <ChatTab
                currentUser="ahmed"
                messages={messages}
                onUpdateMessages={setMessages}
                onStartCall={() => {}}
                partnerOnline={true}
              />
            </div>
          ) : (
            <div className="w-full flex min-h-0 flex-1 flex-col overflow-x-hidden">
              <VoiceAIStudioTab currentUser="ahmed" />
            </div>
          )}
        </div>

        <BottomNavBar
          activeTab={tab}
          onSelectTab={(id) => {
            if (id === "chat" || id === "ai_studio") setTab(id as "chat" | "ai_studio");
          }}
          currentUser="ahmed"
        />
      </main>
    </div>
  );
}

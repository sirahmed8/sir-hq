export function isProfileAccent(value: unknown): value is ProfileAccent {
  return typeof value === "string" && (PROFILE_ACCENTS as readonly string[]).includes(value);
}

/** Shape check for a stored profile. A damaged record reads as "no profile" instead of crashing the screen. */
export function isPersonProfile(value: unknown): value is PersonProfile {
  if (typeof value !== "object" || value === null) return false;
  const v = value as Record<string, unknown>;
  return (
    typeof v.name === "string" &&
    typeof v.bio === "string" &&
    isProfileAccent(v.accent) &&
    (v.avatar === null || (typeof v.avatar === "string" && v.avatar.startsWith("data:image/jpeg;base64,"))) &&
    typeof v.updatedAt === "number" &&
    Number.isFinite(v.updatedAt)
  );
}

/** Initial letter for the avatar fallback (first visible character of the name). */
export function initialOf(name: string): string {
  const first = Array.from(name.trim())[0];
  return first ? first.toUpperCase() : "?";
}

"use client";

import React, { useEffect, useState } from "react";
import { AvatarEditor } from "@/components/profile/AvatarEditor";

/**
 * Dev-only check page for the profile photo crop sheet. The source is a generated gradient,
 * not a person's photo. Not linked from the app.
 */
export default function DevAvatarEditorPage() {
  const [source, setSource] = useState<ImageBitmap | null>(null);
  const [saved, setSaved] = useState<string | null>(null);

  useEffect(() => {
    const canvas = document.createElement("canvas");
    canvas.width = 480;
    canvas.height = 240;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const grad = ctx.createLinearGradient(0, 0, 480, 240);
    grad.addColorStop(0, "#f43f5e");
    grad.addColorStop(1, "#0ea5e9");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 480, 240);
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(220, 0, 40, 240);
    void createImageBitmap(canvas).then(setSource);
  }, []);

  return (
    <main className="mx-auto flex w-full max-w-[400px] flex-col items-center gap-6 px-4 pb-10 pt-8">
      {source && <AvatarEditor source={source} isRtl onCancel={() => setSaved("cancelled")} onSave={setSaved} />}
      {saved && saved !== "cancelled" && (
        // eslint-disable-next-line @next/next/no-img-element -- dev harness shows the saved data URL
        <img data-testid="saved-avatar" src={saved} alt="" className="h-24 w-24 rounded-full" />
      )}
      <p data-testid="saved-state" className="text-xs text-white/70">{saved ? (saved === "cancelled" ? "cancelled" : "saved") : "open"}</p>
    </main>
  );
}

export interface CheckboxProps extends Omit<React.InputHTMLAttributes<HTMLInputElement>, "type" | "onChange"> {
  label?: React.ReactNode;
  description?: React.ReactNode;
  indeterminate?: boolean;
  onCheckedChange?: (checked: boolean) => void;
}

/** A checkbox with an animated tick. The real input stays in the page, so forms, labels and keyboards work. */
export const Checkbox = React.forwardRef<HTMLInputElement, CheckboxProps>(function Checkbox(
  { label, description, indeterminate, onCheckedChange, className, disabled, ...rest },
  forwarded,
) {
  const inner = useRef<HTMLInputElement | null>(null);
  useEffect(() => {
    if (inner.current) inner.current.indeterminate = Boolean(indeterminate);
  }, [indeterminate]);
  return (
    <label className={cn("ui-check", className)} data-disabled={disabled ? "true" : undefined}>
      <input
        {...rest}
        ref={(node) => {
          inner.current = node;
          if (typeof forwarded === "function") forwarded(node);
          else if (forwarded) forwarded.current = node;
        }}
        type="checkbox"
        disabled={disabled}
        className="ui-check__input"
        onChange={(e) => onCheckedChange?.(e.target.checked)}
      />
      <span className="ui-check__box" aria-hidden="true">
        <svg viewBox="0 0 16 16" className="ui-check__mark"><path d="M3.5 8.5l3 3 6-7" /></svg>
      </span>
      {(label || description) && (
        <span className="flex min-w-0 flex-col">
          {label && <span className="text-sm font-bold">{label}</span>}
          {description && <span className="us-muted">{description}</span>}
        </span>
      )}
    </label>
  );
});


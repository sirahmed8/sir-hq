36: export const INITIAL_VIEWPORT: ViewportState = { baseline: 0, landscape: false, open: false, keyboardPx: 0, height: 0, top: 0 };
36: 
36: /** The next state. The baseline only grows while no field has focus, and starts again when the phone is rotated. */
36: export function nextViewport(prev: ViewportState, sample: ViewportSample): ViewportState {
36:   const landscape = sample.innerWidth > sample.innerHeight;
36:   const rotated = prev.baseline > 0 && landscape !== prev.landscape;
36:   const tallest = Math.max(sample.innerHeight, sample.vvHeight);
36:   let baseline = rotated || prev.baseline === 0 ? tallest : prev.baseline;
36:   if (!sample.focused) baseline = Math.max(baseline, tallest);
36:   const drop = baseline - sample.vvHeight;
36:   const hasKeyboardDrop = drop > KEYBOARD_MIN_PX;
36:   const zoomed = (sample.scale ?? 1) > ZOOM_TOLERANCE;
36:   // Only a focused text field with a real drop opens the keyboard. An open flag that outlives its field
36:   // (blur while the page is still zoomed) hides the dock with pointer-events: none and nothing can be tapped.
36:   const open = !zoomed && hasKeyboardDrop && sample.focused;
36:   return {
36:     baseline,
36:     landscape,
36:     open,
36:     keyboardPx: open ? Math.round(drop) : 0,
36:     height: Math.round(sample.vvHeight),
36:     top: Math.max(0, Math.round(sample.vvTop)),
36:   };
36: }
36: 
36: const NON_TEXT_INPUTS = new Set(["button", "checkbox", "radio", "range", "file", "submit", "color", "image", "reset"]);
36: 
36: /** Whether the element opens the keyboard. */
36: export function opensKeyboard(tag: string, inputType: string, editable: boolean): boolean {
36:   const name = tag.toLowerCase();
36:   if (name === "textarea") return true;
36:   if (name === "input") return !NON_TEXT_INPUTS.has(inputType.toLowerCase());
36:   return editable;

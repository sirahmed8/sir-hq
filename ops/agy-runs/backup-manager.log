import test from "node:test";
import assert from "node:assert/strict";

import {
  clampState,
  coverScale,
  drawPlan,
  nextRotation,
  rotatedSize,
  rotateState,
} from "../src/lib/profile/avatarEditor.ts";

// Helpers --------------------------------------------------------------------

const FRAME = 100;
const WIDE = { width: 200, height: 100 };

// rotatedSize ----------------------------------------------------------------

test("rotatedSize swaps axes at quarter-turns only", () => {
  assert.deepEqual(rotatedSize(3, 4, 0), { w: 3, h: 4 });
  assert.deepEqual(rotatedSize(3, 4, 90), { w: 4, h: 3 });
  assert.deepEqual(rotatedSize(3, 4, 180), { w: 3, h: 4 });
  assert.deepEqual(rotatedSize(3, 4, 270), { w: 4, h: 3 });
});

// coverScale -----------------------------------------------------------------

test("coverScale fills both frame axes at zoom 1", () => {
  // wide photo: height needs to grow to cover 100px frame
  assert.equal(coverScale(WIDE.width, WIDE.height, FRAME, 0), 1);
  // after rotation it is tall: width needs scaling
  assert.equal(coverScale(WIDE.width, WIDE.height, FRAME, 90), 1);
});

// nextRotation ---------------------------------------------------------------

test("nextRotation advances in quarter turns with wrap", () => {
  assert.equal(nextRotation(0), 90);
  assert.equal(nextRotation(90), 180);
  assert.equal(nextRotation(180), 270);
  assert.equal(nextRotation(270), 0);
});

// clampState -----------------------------------------------------------------

test("clampState keeps zoom and offsets inside limits", () => {
  const state = { zoom: 1, offsetX: 0, offsetY: 0, rotation: 0 };
  const clamped = clampState(WIDE.width, WIDE.height, FRAME, state);
  assert.equal(clamped.zoom, 1);
  assert.equal(clamped.offsetX, 0);
  assert.equal(clamped.offsetY, 0);
});

test("clampState clamps zoom independently", () => {
  const hi = clampState(WIDE.width, WIDE.height, FRAME, { zoom: 10, offsetX: 0, offsetY: 0, rotation: 0 });
  const lo = clampState(WIDE.width, WIDE.height, FRAME, { zoom: 0.5, offsetX: 0, offsetY: 0, rotation: 0 });
  assert.equal(hi.zoom, 4);
  assert.equal(lo.zoom, 1);
});

// rotateState (the rotation fix) ---------------------------------------------

test("rotateState preserves content under rotating photo", () => {
  // set up: wide photo panned to right edge
  // at rotation 0 maxOffset x = 50, y = 0 (default zoom 1, h=100)
  const pre = { zoom: 1, offsetX: 50, offsetY: 0, rotation: 0 };
  const post = rotateState(WIDE.width, WIDE.height, FRAME, pre);
  // rotation advanced
  assert.equal(post.rotation, 90);
  // offset content preserved in rotated frame
  // the right edge of the original photo becomes the bottom edge after rotation
  // (ox, oy) -> (-oy, ox) so (50, 0) -> (0, 50)
  assert.equal(post.offsetY, 50);
  assert.equal(post.offsetX, 0);
});

test("rotateState with zoom preserves content", () => {
  const pre = { zoom: 2, offsetX: 73, offsetY: -15, rotation: 180 };
  const post = rotateState(WIDE.width, WIDE.height, FRAME, pre);
  assert.equal(post.rotation, 270);
  // ox and oy are scaled by nothing (frame-relative offsets; zoom inside clampState handles size)
  assert.equal(post.offsetX, 15);
  assert.equal(post.offsetY, 73);
});

test("rotateState in quick turnaround 4x returns original", () => {
  const pre = { zoom: 1.5, offsetX: 30, offsetY: 10, rotation: 0 };
  const one = rotateState(WIDE.width, WIDE.height, FRAME, pre);
  const two = rotateState(WIDE.width, WIDE.height, FRAME, one);
  const three = rotateState(WIDE.width, WIDE.height, FRAME, two);
  const four = rotateState(WIDE.width, WIDE.height, FRAME, three);
  assert.equal(four.rotation, 0);
  assert.equal(four.offsetX, pre.offsetX);
  assert.equal(four.offsetY, pre.offsetY);
});

// Test output drawPlan for rotated canvas consistency ------------------------

test("drawPlan centres and corrects scale for frame", () => {
  const plan = drawPlan(100, 100, FRAME, 256, { zoom: 1, offsetX: 10, offsetY: 20, rotation: 0 });
  assert.equal(plan.rotation, 0);
  assert.ok(Math.abs(plan.scale - 2.56) < 1e-6);
  assert.equal(plan.cx, 128 + 10 * 2.56);
  assert.equal(plan.cy, 128 + 20 * 2.56);
});

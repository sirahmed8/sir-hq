    const isTextField = (el: HTMLElement): boolean =>
      el.tagName === "TEXTAREA" ||
      (el.tagName === "INPUT" &&
        !["checkbox", "radio", "range", "file", "button", "submit", "reset", "color", "image", "hidden"].includes(
          (el as HTMLInputElement).type,
        ));

    const reveal = (el: HTMLElement | null) => {
      if (cancelled || !el) return;
      if (!isTextField(el)) return;
      const scrollable =
        el.closest<HTMLElement>("[data-scroll-reveal], [data-swipe-pager], main, [role=main], article, section") ??
        document.scrollingElement ??
        null;
      if (!scrollable) return;
      // Let the keyboard animate in before measuring; scrollIntoView is cheap either way.
      setTimeout(() => {
        if (cancelled) return;
        try {
          el.scrollIntoView({ behavior: "auto", block: "center", inline: "nearest" });
        } catch {}
      }, 350);
    };

    const onFocusIn = (event: FocusEvent) => {
      reveal(event.target instanceof HTMLElement ? event.target : null);
    };
    document.addEventListener("focusin", onFocusIn);
    return () => {
      cancelled = true;
      document.removeEventListener("focusin", onFocusIn);
    };
  }, []);
}
